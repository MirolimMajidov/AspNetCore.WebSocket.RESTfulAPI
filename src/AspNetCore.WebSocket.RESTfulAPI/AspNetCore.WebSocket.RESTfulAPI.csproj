<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Authors>Mirolim Majidov</Authors>
    <Company>PanjakentGroup</Company>
    <Description>This is for using WebSocket like RESTfull API on ASP.NET Core project to create tool for everything. TargetFramework is NET10.0</Description>
    <RepositoryType>https://github.com/MirolimMajidov/AspNetCore.WebSocket.RESTfulAPI</RepositoryType>
    <RepositoryUrl>https://github.com/MirolimMajidov/AspNetCore.WebSocket.RESTfulAPI</RepositoryUrl>
    <PackageTags>AspNetCore.WebSocket.RESTfulAPI, AspNetCore, WebSocket, RESTfulAPI</PackageTags>
    <NeutralLanguage>en-US</NeutralLanguage>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Version>2.0.11</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.14" />
    <PackageReference Include="Microsoft.AspNetCore.WebSockets" Version="2.3.14" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.15" />
  </ItemGroup>

</Project>
